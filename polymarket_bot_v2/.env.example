# Polymarket Bot V2 — environment template.
# 复制为 .env 并填入真实值；.env 已在 .gitignore 中。
#
# T471 (2026-04-28 cutover): py-clob-client-v2 + pUSD trading collateral.
# T474/T479: 仅 user_session(Privy) 通道；DASHBOARD_KEY/TOTP/?key= 全部下线。
# 系统铁律：DRY_RUN 不存在；不要再加任何 V1 单用户 bot 相关变量。

# ── DeepSeek AI（T863 / T866 5-key round-robin） ─────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_1=
DEEPSEEK_API_KEY_2=
DEEPSEEK_API_KEY_3=
DEEPSEEK_API_KEY_4=

# ── Polygon 钱包私钥（系统侧 builder/relayer 签名钱包） ─────────────
POLY_PRIVATE_KEY=

# ── Polymarket CLOB v2 L2 凭据（POLY_PRIVATE_KEY 派生） ─────────────
POLY_API_KEY=
POLY_SECRET=
POLY_PASSPHRASE=

# ── Builder 归因 Code（bytes32） ─────────────────────────────────
POLY_BUILDER_CODE=

# ── V2 cutover toggle (T471) ────────────────────────────────────
PM_USE_V2=1

# ── PostgreSQL ──────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=

# ── Privy + Relayer (V2) ─────────────────────────────────────────
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY_V2=
PRIVY_SERVER_SIGNER_ID=
PRIVY_SERVER_SIGNER_POLICY_IDS=
# Privy 身份令牌 PEM 文件路径：config/privy_verification_key.pem（PEM 存在则
# 不需要再设置 PRIVY_VERIFICATION_KEY 环境变量）

# ── 会话签名（T474/T479 单通道） ─────────────────────────────────
# USER_SESSION_SECRET 是 user_session HMAC 签名种子；必须在生产设置。
USER_SESSION_SECRET=

# ── 可选：通知 / 数据源 ─────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# RAPIDAPI_KEY=
# T869: 备用 RapidAPI key（独立账号，免费 250 次/月），仅在主 key 阻塞/429 时启用
# RAPIDAPI_KEY_BACKUP=
